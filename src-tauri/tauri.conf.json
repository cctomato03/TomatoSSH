{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TomatoSSH",
  "version": "1.0.1",
  "identifier": "com.tomatossh.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TomatoSSH",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "SSH / SFTP 桌面客户端",
    "longDescription": "TomatoSSH 是一个跨平台的 SSH / SFTP 桌面客户端，支持分组管理、多标签终端、本地终端、文件传输与云端同步。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {}
}
