# 复制为 .env 后按需修改：cp .env.example .env

# 必填：登录令牌签名密钥，生产环境务必固定
# 生成方式：openssl rand -hex 32
JWT_SECRET=请替换为随机字符串

# 部署完成后建议改为 false，关闭公开注册
ALLOW_REGISTER=true

# 登录令牌有效期（小时），默认 30 天
TOKEN_TTL_HOURS=720

# 单个保险库密文上限（字节），默认 16MB
MAX_BLOB_BYTES=16777216

# 监听地址（容器内）
BIND_ADDR=0.0.0.0:8787

# 日志级别
RUST_LOG=tomatossh_sync=info,tower_http=warn
